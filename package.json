{
  "name": "chipscope",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @workspace/chipscope run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "build:api": "pnpm --filter @workspace/api-server run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm --filter @workspace/chipscope --filter @workspace/api-server run typecheck",
    "verify:source": "node scripts/verify-source.mjs",
    "validate:data": "python3 pipeline/validate.py",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "db:push": "pnpm --filter @workspace/db run push"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "prettier": "^3.9.6"
  }
}
